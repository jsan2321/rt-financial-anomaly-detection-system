# ==============================================================================
# RT-FADS Environment Configuration Template
# Real-Time Financial Anomaly Detection System
# Copy this file to .env before starting services: cp .env.example .env
# ==============================================================================

# --- Environment & Logging ---
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# --- PostgreSQL & TimescaleDB ---
POSTGRES_DB=rt_fads
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/rt_fads
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rt_fads

# --- Redis (Streams & Pub/Sub) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# --- OpenTelemetry & Jaeger Observability ---
OTEL_SERVICE_NAME=rt-fads
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
JAEGER_UI_PORT=16686

# --- Service Port Allocation ---
GATEWAY_PORT=8000
ADMIN_PORT=8001
FRONTEND_PORT=3000

# --- Security & Authentication ---
JWT_SECRET_KEY=change-in-production-use-strong-secret-key-32-chars-min
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
API_KEY=fads-dev-api-key-demo
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Outbox & Stream Processing Settings ---
OUTBOX_POLL_INTERVAL_MS=200
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_RETRIES=5
STREAM_TRANSACTIONS=stream:transactions
STREAM_ALERTS=stream:alerts
STREAM_ESCALATIONS=stream:escalations
STREAM_COMPENSATION=stream:compensation
REDIS_PUBSUB_NOTIFICATIONS=ws:notifications

# --- Anomaly Detection & Demonstration ---
DEMO_MODE=false
COMPOSITE_SCORE_THRESHOLD=0.6
RULE_WEIGHT=0.4
ML_WEIGHT=0.4
PROFILE_WEIGHT=0.2
ESCALATION_EMAIL_MINUTES=5
ESCALATION_SLACK_MINUTES=10
